{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": { "includeFiles": "public/**", "maxDuration": 60 }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index" },
    { "src": "^/auth/.*$", "dest": "/api/index" },
    { "src": "^/api/.*$", "dest": "/api/index" },
    { "handle": "filesystem" }
  ]
}